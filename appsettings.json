{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",

      "Arbitrage.Api.Infrastructure.MarketData.Streams.Binance.BinanceBboStream": "Information",
      "Arbitrage.Api.Infrastructure.MarketData.Streams.Bybit.BybitBboStream": "Information",
      "Arbitrage.Api.Infrastructure.MarketData.Streams.Okx.OkxBboStream": "Warning",

      "Arbitrage.Api.Infrastructure.MarketData.Streams.Binance.BinanceOrderBookDepthStream": "Information",
      "Arbitrage.Api.Infrastructure.MarketData.Streams.Bybit.BybitOrderBookDepthStream": "Information",
      "Arbitrage.Api.Infrastructure.MarketData.Streams.Okx.OkxOrderBookDepthStream": "Information"
    }
  },

  "MarketDataStreams": {
    "Enabled": true,
    "DiscoveredPairsPath": "Data/universe/usdt-perp-pairs.json",
    "EnabledConnectors": [
      "binance_perpetual",
      "bybit_perpetual",
      "okx_perpetual",
      "bitget_perpetual",
      "gate_io_perpetual",
      "kucoin_perpetual",
      "mexc_perpetual",
      "bitmart_perpetual"
    ],
    "MaxSnapshotAgeMs": 3000
  },

  "SpreadDetector": {
    "Enabled": true,
    "IntervalMs": 1000,
    "MinGrossSpreadPct": 0.03,
    "MaxSnapshotAgeMs": 10000,
    "MaxCandidatesToKeep": 100,
    "CandidateTtlMs": 15000
  },
  "TradingPairUniverse": {
    "Enabled": true,
    "RefreshOnStartup": true,
    "RefreshIntervalMinutes": 360,
    "OutputPath": "Data/universe/usdt-perp-pairs.json",
    "QuoteAsset": "USDT",
    "EnabledConnectors": [
      "binance_perpetual",
      "bybit_perpetual",
      "okx_perpetual",
      "bitget_perpetual",
      "gate_io_perpetual",
      "kucoin_perpetual",
      "mexc_perpetual",
      "bitmart_perpetual"
    ]
  },
  "DepthTracking": {
    "Enabled": true,
    "IntervalMs": 500,
    "CandidateMaxAgeMs": 15000,
    "MaxCandidatesToTrack": 20,
    "MaxPairsPerConnector": 40
  },
  "ValidatedOpportunities": {
    "Enabled": true,
    "IntervalMs": 1000,
    "MaxCandidates": 20,
    "NotionalUsd": 100,
    "MinNetEdgePct": 0,
    "MaxDepthAgeMs": 10000,
    "MinCandidateAgeMs": 1500,
    "DefaultTakerFeePct": 0.055,
    "CloseFeeBufferPct": 0.11,
    "SafetyBufferPct": 0.05,
    "TakerFeesPct": {
      "binance_perpetual": 0.05,
      "bybit_perpetual": 0.055,
      "okx_perpetual": 0.05,
      "bitget_perpetual": 0.06,
      "gate_io_perpetual": 0.05,
      "mexc_perpetual": 0.01,
      "bitmart_perpetual": 0.06
    },
    "IncludeNetEdgeBelowMinimum": true,
    "IncludeNotFullyFillable": true,
    "IncludeMissingDepth": false
  },

  "AllowedHosts": "*"
}