  "SignalQuality": {
    "Enabled": true,
    "MinCandidateNetEdgePct": 0.2,
    "MinAlertNetEdgePct": 0.3,
    "MinEpisodeSamples": 3,
    "MinEpisodeDurationSeconds": 20,
    "EpisodeMaxGapSeconds": 25,
    "MaxBuySlippagePct": 0.15,
    "MaxSellSlippagePct": 0.15,
    "BlockedConnectors": [],
    "AllowedTradingPairs": [],
    "BlockedTradingPairs": []
  },
  "Execution": {
    "Mode": "Disabled",
    "MaxLiveNotionalUsd": 10,
    "MaxAttemptsPerArm": 1,
    "ArmExpiresAfterSeconds": 600,
    "MaxLegDelayMs": 1500,
    "MaxAllowedSlippagePct": 0.15,
    "KillSwitchEnabledOnStartup": true,
    "RequireOneShotArm": true,
    "EnabledConnectors": [
      "bybit_perpetual",
      "htx_perpetual"
    ]
  },
  "DataProtection": {
    "ApplicationName": "Arbitrage.Api"
  },
  "BybitTrading": {
    "BaseUrl": "https://api.bybit.com",
    "AccountType": "UNIFIED",
    "RecvWindowMs": 5000,
    "Category": "linear"
  },
  "HtxTrading": {
    "BaseUrl": "https://api.hbdm.com",
    "SignatureHost": "api.hbdm.com",
    "AccountInfoPath": "/linear-swap-api/v3/unified_account_info",
    "ContractInfoPath": "/linear-swap-api/v1/swap_contract_info"
  },

  "AllowedHosts": "*",

  "Postgres": {
    "Enabled": true,
    "ConnectionString": "Host=localhost;Port=5432;Database=arbitrage;Username=arbitrage;Password=arbitrage;GSS Encryption Mode=Disable",
    "PersistSameSignalIntervalSeconds": 10
  }
}